{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/execution/transition-journal.schema.json",
  "title": "Execution Transition Journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transitionType",
    "taskId",
    "attempt",
    "runPath",
    "expectedRevision",
    "targetRevision",
    "selectionDigest",
    "phase",
    "officialTimestamp",
    "expectedArtifacts",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "transitionType": {
      "const": "prepare-task-run"
    },
    "taskId": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9][A-Z0-9_-]*$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "runPath": {
      "type": "string",
      "pattern": "^\\.devflow/execution/runs/TASK-[A-Z0-9][A-Z0-9_-]*/attempt-[0-9]{2,}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 0
    },
    "selectionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "phase": {
      "enum": [
        "started"
      ]
    },
    "officialTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "expectedArtifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$comment": "La relación targetRevision = expectedRevision + 1, el runPath canónico y expectedArtifacts exactos se validan además en execution-contract-helpers.mjs."
}
