{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devflow.local/schemas/software-architect/project-state.schema.json",
  "title": "DevFlow Software Blueprint State v2",
  "description": "Estado canónico del Software Blueprint, consumido por software-architect y subagentes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "phases",
    "documents",
    "changeLog"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "phases": {
      "$ref": "#/$defs/phases"
    },
    "confirmed": {
      "$ref": "#/$defs/confirmed"
    },
    "productRequirements": {
      "$ref": "#/$defs/productRequirements"
    },
    "applicationFlow": {
      "$ref": "#/$defs/applicationFlow"
    },
    "uiuxBrief": {
      "$ref": "#/$defs/uiuxBrief"
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "functionalRequirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/functionalRequirement" }
    },
    "backendSchema": {
      "$ref": "#/$defs/backendSchema"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "technologyStack": {
      "$ref": "#/$defs/technologyStack"
    },
    "technicalRequirements": {
      "$ref": "#/$defs/technicalRequirements"
    },
    "approvedDecisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk" }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pendingApprovals": {
      "type": "array",
      "items": { "$ref": "#/$defs/pendingApproval" }
    },
    "documents": {
      "$ref": "#/$defs/documents"
    },
    "changeLog": {
      "type": "array",
      "items": { "$ref": "#/$defs/changeLogEntry" }
    }
  },
  "$defs": {
    "nullableDateTime": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "nullableString": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "workingTitle",
        "description",
        "status",
        "currentPhase",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nullableString" },
        "workingTitle": { "$ref": "#/$defs/nullableString" },
        "description": { "$ref": "#/$defs/nullableString" },
        "status": {
          "enum": ["in_progress", "completed", "blocked", null]
        },
        "currentPhase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        },
        "createdAt": { "$ref": "#/$defs/nullableDateTime" },
        "updatedAt": { "$ref": "#/$defs/nullableDateTime" }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": [
          "1_discovery",
          "2_product_requirements",
          "3_application_flow",
          "4_uiux_brief",
          "5_module_catalog",
          "6_functional_requirements",
          "7_backend_schema",
          "8_solution_architecture",
          "9_technology_stack",
          "10_security_and_nfr",
          "11_technical_requirements",
          "12_delivery_roadmap",
          "13_software_blueprint",
          "14_consistency_review"
        ]
      },
      "patternProperties": {
        "^[0-9]+_": {
          "enum": [
            "pending",
            "in_progress",
            "waiting_for_user",
            "needs_revision",
            "approved",
            "blocked"
          ]
        }
      }
    },
    "confirmed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem": { "$ref": "#/$defs/nullableString" },
        "currentOperation": { "$ref": "#/$defs/nullableString" },
        "targetUsers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "buyer": { "$ref": "#/$defs/nullableString" },
        "beneficiaries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "objectives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "successCriteria": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outOfScope": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "productRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vision": { "$ref": "#/$defs/nullableString" },
        "valueProposition": { "$ref": "#/$defs/nullableString" },
        "objectives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mvpScope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "postMvpScope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outOfScope": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "applicationFlow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "actors": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "controlPoints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "uiuxBrief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "designSystem": { "$ref": "#/$defs/nullableString" },
        "brandColors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "typography": { "$ref": "#/$defs/nullableString" },
        "targetDevices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "accessibility": { "$ref": "#/$defs/nullableString" },
        "keyScreens": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "objective": { "type": "string" },
        "users": { "type": "string" },
        "responsibilities": { "type": "string" },
        "functions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "permissions": { "type": "string" },
        "priority": { "type": "string" }
      }
    },
    "functionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "module": { "type": "string" },
        "priority": { "type": "string" },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "backendSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "attributes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "relations": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "sensitiveData": {
          "type": "array",
          "items": { "type": "string" }
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "system": { "type": "string" },
              "type": { "type": "string" },
              "protocol": { "type": "string" },
              "frequency": { "type": "string" },
              "volume": { "type": "string" }
            }
          }
        },
        "volumeEstimates": { "$ref": "#/$defs/nullableString" }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["pending", "in_progress", "approved", null]
        },
        "style": { "$ref": "#/$defs/nullableString" },
        "description": { "$ref": "#/$defs/nullableString" },
        "layers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "principles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "technologyStack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["pending", "in_progress", "approved", null]
        },
        "approvedStack": {
          "type": "object"
        }
      }
    },
    "technicalRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "performance": { "$ref": "#/$defs/nullableString" },
        "scalability": { "$ref": "#/$defs/nullableString" },
        "availability": { "$ref": "#/$defs/nullableString" },
        "compliance": { "$ref": "#/$defs/nullableString" },
        "security": { "$ref": "#/$defs/nullableString" },
        "monitoring": { "$ref": "#/$defs/nullableString" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assumption": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk": { "type": "string" },
        "impact": { "type": "string" },
        "mitigation": { "type": "string" }
      }
    },
    "pendingApproval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": { "type": "string" },
        "requestedAt": { "$ref": "#/$defs/nullableDateTime" },
        "status": { "type": "string" }
      }
    },
    "documentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["pending", "approved"]
        },
        "approvedAt": { "$ref": "#/$defs/nullableDateTime" }
      }
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "01_discovery",
        "02_product_requirements",
        "03_application_flow",
        "04_uiux_brief",
        "05_module_catalog",
        "06_functional_requirements",
        "07_backend_schema",
        "08_solution_architecture",
        "09_technology_stack",
        "10_security_and_nfr",
        "11_technical_requirements",
        "12_delivery_roadmap",
        "13_software_blueprint",
        "14_consistency_review"
      ],
      "properties": {
        "01_discovery": { "$ref": "#/$defs/documentEntry" },
        "02_product_requirements": { "$ref": "#/$defs/documentEntry" },
        "03_application_flow": { "$ref": "#/$defs/documentEntry" },
        "04_uiux_brief": { "$ref": "#/$defs/documentEntry" },
        "05_module_catalog": { "$ref": "#/$defs/documentEntry" },
        "06_functional_requirements": { "$ref": "#/$defs/documentEntry" },
        "07_backend_schema": { "$ref": "#/$defs/documentEntry" },
        "08_solution_architecture": { "$ref": "#/$defs/documentEntry" },
        "09_technology_stack": { "$ref": "#/$defs/documentEntry" },
        "10_security_and_nfr": { "$ref": "#/$defs/documentEntry" },
        "11_technical_requirements": { "$ref": "#/$defs/documentEntry" },
        "12_delivery_roadmap": { "$ref": "#/$defs/documentEntry" },
        "13_software_blueprint": { "$ref": "#/$defs/documentEntry" },
        "14_consistency_review": { "$ref": "#/$defs/documentEntry" }
      }
    },
    "changeLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/nullableDateTime" },
        "action": { "type": "string" },
        "details": { "type": "string" }
      }
    }
  }
}
